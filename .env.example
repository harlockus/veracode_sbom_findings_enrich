# Copy to .env and fill in. Never commit .env.
# Keep each value on one line. Do not put the key on the command line.
# Generate the id and key from a Veracode UI user: My Account > API Credentials.
# Findings and SBOM generation also accept an API service account with the Results API role.
# Workspace issues and safe-version lookups require the UI user credential.

VERACODE_API_KEY_ID=
VERACODE_API_KEY_SECRET=

# us, eu, or federal. Ignored when VERACODE_API_HOST is set.
VERACODE_API_REGION=us
# VERACODE_API_HOST=api.veracode.com

# Optional defaults used when collect is run with no target flags.
# VERACODE_APP=verademo
# VERACODE_WORKSPACE=

# Sent as the User-Agent. The SCA REST API requires one.
# VERACODE_USER_AGENT=SBOM-Findings/1.0
